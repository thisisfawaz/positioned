# Copy to .env (local) or set these in the hosting provider's dashboard.
# NEVER commit real secrets.

# --- Database (Supabase) ---------------------------------------------------
DATABASE_URL="postgresql://...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://...pooler.supabase.com:5432/postgres"

# --- Media storage (Cloudinary) --------------------------------------------
# Find these in the Cloudinary dashboard: Dashboard > Product Environment
# Credentials. Server-only; do NOT prefix with NEXT_PUBLIC_.
#
# When all three are set, /api/upload stores images AND video on Cloudinary.
# When any is missing, the route falls back to LOCAL disk (images only,
# development only - public/uploads is not writable on Vercel).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
